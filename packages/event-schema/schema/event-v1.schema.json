{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-office:schema:event:1.0",
  "title": "AgentOfficeEventV1",
  "description": "Privacy-minimized normalized activity metadata sent by an Agent Office Collector.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "device_id",
    "session_id",
    "agent_id",
    "parent_agent_id",
    "provider",
    "source",
    "event_type",
    "activity",
    "confidence",
    "occurred_at",
    "sequence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36
    },
    "device_id": {
      "type": "string",
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36
    },
    "session_id": {
      "type": "string",
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36
    },
    "agent_id": {
      "type": "string",
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36
    },
    "parent_agent_id": {
      "oneOf": [
        {
          "type": "string",
          "format": "uuid",
          "minLength": 36,
          "maxLength": 36
        },
        {
          "type": "null"
        }
      ]
    },
    "provider": {
      "type": "string",
      "enum": ["codex", "claude", "unknown"]
    },
    "source": {
      "type": "string",
      "enum": ["hook", "jsonl", "app_server", "inferred"]
    },
    "event_type": {
      "type": "string",
      "enum": [
        "session.discovered",
        "session.started",
        "session.ended",
        "turn.started",
        "turn.completed",
        "turn.interrupted",
        "tool.started",
        "tool.completed",
        "tool.failed",
        "approval.requested",
        "approval.resolved",
        "agent.started",
        "agent.completed",
        "plan.updated",
        "unknown"
      ]
    },
    "activity": {
      "type": "string",
      "enum": [
        "reading",
        "browsing",
        "coding",
        "testing",
        "planning",
        "delegating",
        "reporting",
        "thinking",
        "waiting_user",
        "idle",
        "unknown"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": ["observed", "inferred"]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40,
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "const": "inferred"
          }
        },
        "required": ["source"]
      },
      "then": {
        "properties": {
          "confidence": {
            "const": "inferred"
          }
        }
      }
    }
  ]
}
