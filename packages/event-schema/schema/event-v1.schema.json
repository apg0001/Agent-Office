{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-office:schema:event:1.0",
  "title": "AgentOfficeEventV1",
  "description": "Privacy-minimized normalized activity metadata sent by an Agent Office Collector.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "device_id",
    "session_id",
    "agent_id",
    "parent_agent_id",
    "provider",
    "source",
    "event_type",
    "activity",
    "confidence",
    "occurred_at",
    "sequence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36
    },
    "device_id": {
      "type": "string",
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36
    },
    "session_id": {
      "type": "string",
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36
    },
    "agent_id": {
      "type": "string",
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36
    },
    "parent_agent_id": {
      "oneOf": [
        {
          "type": "string",
          "format": "uuid",
          "minLength": 36,
          "maxLength": 36
        },
        {
          "type": "null"
        }
      ]
    },
    "provider": {
      "type": "string",
      "enum": [
        "codex",
        "claude",
        "unknown"
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "hook",
        "jsonl",
        "app_server",
        "inferred"
      ]
    },
    "event_type": {
      "type": "string",
      "enum": [
        "session.discovered",
        "session.started",
        "session.ended",
        "turn.started",
        "turn.completed",
        "turn.interrupted",
        "tool.started",
        "tool.completed",
        "tool.failed",
        "approval.requested",
        "approval.resolved",
        "agent.started",
        "agent.completed",
        "plan.updated",
        "unknown"
      ]
    },
    "activity": {
      "type": "string",
      "enum": [
        "reading",
        "browsing",
        "coding",
        "testing",
        "planning",
        "delegating",
        "reporting",
        "thinking",
        "waiting_user",
        "idle",
        "unknown"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "observed",
        "inferred"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40,
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "plan_steps": {
      "description": "plan.updated에서만: 계획 단계의 상태만 순서대로(#38). 단계 문장 등 원문은 담지 않는다.",
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "enum": [
          "pending",
          "in_progress",
          "completed",
          "unknown"
        ]
      }
    },
    "workspace_name": {
      "description": "작업 폴더의 마지막 이름만(#181). 사용자가 PC별로 켰을 때만 보낸다. 전체 경로·상위 폴더·경로 구분자·제어 문자는 담지 않는다.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "not": {
        "description": "`.`·`..`이거나 경로 구분자·제어·서식 문자가 하나라도 있으면 거부한다(줄 끝 `$` 해석 차이를 피하려고 금지 문자를 찾는다).",
        "anyOf": [
          {
            "enum": [
              ".",
              ".."
            ]
          },
          {
            "pattern": "[/\\\\\u0000-\u001f\u007f-\u009f\u00ad\u200b-\u200f\u2028-\u202e\u2060-\u206f\ufeff\ufff9-\ufffb]"
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "const": "inferred"
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "confidence": {
            "const": "inferred"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "plan_steps"
        ]
      },
      "then": {
        "properties": {
          "event_type": {
            "const": "plan.updated"
          }
        }
      }
    }
  ]
}
