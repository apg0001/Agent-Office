{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-office:schema:collector-event-batch-request:1.0",
  "title": "CollectorEventBatchRequestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "events"],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:agent-office:schema:event:1.0"
      }
    }
  }
}
