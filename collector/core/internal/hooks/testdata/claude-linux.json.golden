{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/u/My Tools/it'\\''s/agent-office-collector' hook claude",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/u/My Tools/it'\\''s/agent-office-collector' hook claude",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "'/home/u/My Tools/it'\\''s/agent-office-collector' hook claude",
            "timeout": 5
          }
        ]
      }
    ],
