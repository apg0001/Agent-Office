        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "'/home/u/My Tools/it'\\''s/agent-office-collector' hook claude",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "'/home/u/My Tools/it'\\''s/agent-office-collector' hook claude",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/u/My Tools/it'\\''s/agent-office-collector' hook claude",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/u/My Tools/it'\\''s/agent-office-collector' hook claude",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/u/My Tools/it'\\''s/agent-office-collector' hook claude",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/u/My Tools/it'\\''s/agent-office-collector' hook claude",
